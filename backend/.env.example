# Copy this file to .env and fill in real values:  cp .env.example .env
#
# Nothing here is required yet — the server runs fine with no .env file at all.
# This exists so the dotenv wiring is real and documented from day one. Later
# additions will likely include SUPABASE_URL, SUPABASE_KEY, ANTHROPIC_API_KEY.

# Port the API listens on (defaults to 3001 if unset)
PORT=3001
